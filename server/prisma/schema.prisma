generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  cuidador
  profissional
}

enum EventType {
  fall
  fever
  choking
  breathing_difficulties
  bleeding
  confusion
  chest_pain
  other
}

model User {
  id                Int                @id @default(autoincrement())
  email             String             @unique
  password          String
  role              Role
  crm               String?            @unique
  /// Version of the consent term the user last accepted, null if never.
  consentVersion    String?
  consentAcceptedAt DateTime?
  profiles          Profile[]          @relation("CaregiverProfiles")
  access            ProfileAccess[]
  pushSubscriptions PushSubscription[]
  resolvedAlerts    Alert[]            @relation("AlertResolver")
  missedSignals     MissedSignal[]
  accessLogs        AccessLog[]

  @@map("users")
}

/// Grants a user access to an elderly profile. This is the sole source of
/// authorization: a user may read or write a profile only when a row links
/// them to it, regardless of role. Profile.caregiverId records who first
/// registered the elder and is not consulted for access decisions.
model ProfileAccess {
  id        Int      @id @default(autoincrement())
  profileId Int
  userId    Int
  createdAt DateTime @default(now())
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([profileId, userId])
  @@index([userId])
  @@map("profile_access")
}

model Profile {
  id                Int             @id @default(autoincrement())
  cpf               String?         @unique
  firstName         String
  lastName          String
  birthDate         DateTime        @db.Date
  sex               String?
  scholarship       String
  medicalConditions String[]
  notes             String?
  /// Family contact phone, digits only (DDD + number).
  contactPhone      String?
  caregiverId       Int
  caregiver         User            @relation("CaregiverProfiles", fields: [caregiverId], references: [id], onDelete: Cascade)
  medications       Medication[]
  routines          Routine[]
  checkIns          CheckIn[]
  intercorrences    Intercorrence[]
  alerts            Alert[]
  missedSignals     MissedSignal[]
  access            ProfileAccess[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([caregiverId])
  @@map("profiles")
}

model Medication {
  id        Int      @id @default(autoincrement())
  profileId Int
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  dosage    String
  frequency String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@map("medications")
}

model Routine {
  id          Int      @id @default(autoincrement())
  profileId   Int
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  period      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([profileId])
  @@map("routines")
}

enum Appetite {
  good
  regular
  bad
}

enum Mood {
  very_happy
  happy
  neutral
  sad
  very_sad
}

model CheckIn {
  id                Int      @id @default(autoincrement())
  profileId         Int
  profile           Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date              DateTime @default(now())
  skinIssues        Boolean
  bowelRegular      Boolean
  sleepWell         Boolean
  unstableGait      Boolean
  weeklyEvents      String[]
  otherEvent        String?
  pressure          String?
  saturation        String?
  glycemia          String?
  calfCircumference String?
  appetite          Appetite
  chokingIncident   Boolean
  chokingFrequency  String?
  breathShortness   Boolean
  hydrationGoal     Boolean
  medsOnTime        Boolean
  mood              Mood
  stressLevel       Int
  sunExposure       Boolean
  selfExpression    Boolean
  stimulation       Boolean
  /// The hygiene answers are null on a short-form check-in, which skips that step.
  dailyBath         Boolean?
  oralHygiene       Boolean?
  groomedNails      Boolean?
  shortForm         Boolean  @default(false)
  needsMedications  String[]
  needsHygiene      String[]
  needsFood         String[]
  alerts            Alert[]

  @@index([profileId, date(sort: Desc)])
  @@map("check_ins")
}

model Intercorrence {
  id               Int      @id @default(autoincrement())
  profileId        Int
  profile          Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date             DateTime @default(now())
  eventType        EventType
  isCritical       Boolean  @default(false)
  description      String

  @@index([profileId, date(sort: Desc)])
}

enum AlertType {
  weakened_home_bond
  clinical_warning
  metabolic_decompensation
  sarcopenia_risk
}

enum AlertSeverity {
  attention
  critical
}

model Alert {
  id              Int           @id @default(autoincrement())
  profileId       Int
  profile         Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  checkInId       Int?
  checkIn         CheckIn?      @relation(fields: [checkInId], references: [id], onDelete: SetNull)
  type            AlertType
  severity        AlertSeverity
  message         String
  createdAt       DateTime      @default(now())
  resolvedAt      DateTime?
  /// Who resolved it. Null while open, and also when the system closed it on
  /// its own (a new check-in closes the home bond alert).
  resolvedById    Int?
  resolvedBy      User?         @relation("AlertResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  /// Whether the professional found the signal to be real after contacting
  /// the family. Feeds the false positive count in the validation report.
  signalConfirmed Boolean?

  @@index([profileId, createdAt(sort: Desc)])
  @@index([checkInId])
  @@map("alerts")
}

/// Something that happened to the elder which the system should have flagged
/// but did not (a false negative). Recorded by a professional so the heuristic
/// can be checked against what actually happened.
model MissedSignal {
  id           Int           @id @default(autoincrement())
  profileId    Int
  profile      Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  reportedById Int?
  reportedBy   User?         @relation(fields: [reportedById], references: [id], onDelete: SetNull)
  occurredAt   DateTime      @db.Date
  severity     AlertSeverity
  description  String
  createdAt    DateTime      @default(now())

  @@index([profileId, occurredAt(sort: Desc)])
  @@map("missed_signals")
}

enum PushTransport {
  expo
  webpush
}

/// A device that can receive push notifications. Both transports share one
/// table because dispatch resolves a whole profile audience at once.
///
/// endpoint holds the Expo push token or the web push endpoint URL, and is
/// unique without userId on purpose: a device belongs to whoever signed in
/// last, so re-registering after a different sign-in moves the row instead of
/// adding one. p256dh/auth are web push encryption keys, null for expo.
model PushSubscription {
  id        Int           @id @default(autoincrement())
  userId    Int
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transport PushTransport
  endpoint  String        @unique
  p256dh    String?
  auth      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId])
  @@map("push_subscriptions")
}

/// One row per account per day the app was used, for the monthly usage
/// report. userId is cleared when the account is deleted, so past totals keep
/// adding up without pointing at anyone. role is copied so the split between
/// caregivers and professionals survives that too.
model AccessLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  role      Role
  day       DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([userId, day])
  @@index([day])
  @@map("access_logs")
}
