# Single image for Heroku: the API plus the web build, served from one dyno.
# Built from the repo root (see heroku.yml). The VPS deploy keeps using
# server/Dockerfile and Caddy; this file is only for Heroku.

# Web build. The API lives on the same origin, so the bundle points at a
# relative /api and does not depend on the Heroku domain.
FROM node:22-bookworm-slim AS web
WORKDIR /client
COPY client/package.json client/package-lock.json ./
RUN npm ci
COPY client/ ./
ENV EXPO_PUBLIC_API_URL=/api
RUN npx expo export --platform web --clear

FROM node:22-bookworm-slim AS server-deps
WORKDIR /app
COPY server/package.json server/package-lock.json ./
COPY server/prisma ./prisma
RUN npm ci

FROM node:22-bookworm-slim AS server-build
WORKDIR /app
COPY --from=server-deps /app/node_modules ./node_modules
COPY server/package.json server/package-lock.json server/tsconfig.json ./
COPY server/prisma ./prisma
COPY server/src ./src
RUN npm run build

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
ENV WEB_DIR=/app/web
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*

COPY server/package.json server/package-lock.json ./
COPY server/prisma ./prisma
RUN npm ci --omit=dev && npm cache clean --force

COPY --from=server-build /app/dist ./dist
COPY --from=web /client/dist ./web
RUN chown -R node:node /app

USER node

# Heroku sets PORT. Migrations run in the release phase (heroku.yml), not here,
# so a failed migration stops the release instead of every dyno boot.
CMD ["node", "dist/index.js"]
