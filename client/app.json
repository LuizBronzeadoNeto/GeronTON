{
  "expo": {
    "name": "GeronTON",
    "slug": "geronton",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "geronton",
    "userInterfaceStyle": "light",
    "primaryColor": "#1A65B5",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.geronton.client"
    },
    "android": {
      "package": "com.geronton.client",
      "versionCode": 1,
      "permissions": [],
      "adaptiveIcon": {
        "backgroundColor": "#1A65B5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "GeronTON",
      "shortName": "GeronTON",
      "lang": "pt-BR",
      "description": "Acompanhamento de idosos para cuidadores e profissionais de saude",
      "themeColor": "#1A65B5",
      "backgroundColor": "#FFFFFF",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e2321642-6c84-4d65-bfd8-48c103513634"
      }
    },
    "owner": "mikaelbfaa"
  }
}
